---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import FAQAccordion from "../components/islands/FAQAccordion.tsx";
---

<BaseLayout
  title="Bank Uncensored Online — ความลับที่แบงก์ไม่เคยบอก | WinWin Wealth"
  description="คลาสออนไลน์ 4 ชั่วโมง สอนโดยอดีต RM ธนาคาร 7 ปี เรียนจบ เช็คตัวเองได้ทันทีว่าพร้อมกู้แค่ไหน"
>
  <Navbar />
  <main class="bg-black min-h-screen text-gray-50 flex flex-col selection:bg-yellow-400/30">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- S1: HeroSection -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <section class="w-full bg-black py-8 md:py-12 mt-1 md:mt-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative w-full max-w-5xl mx-auto overflow-hidden rounded-2xl md:rounded-3xl shadow-[0_20px_50px_-12px_rgba(250,204,21,0.15)] border border-yellow-400/20 bg-zinc-900/40">
          <div class="relative w-full md:h-[80vh] overflow-hidden rounded-2xl md:rounded-3xl shadow-[0_20px_50px_-12px_rgba(250,204,21,0.15)] border border-yellow-400/20">
            <img src="/images/mainkvbuc2.webp" alt="Bank Uncensored Online Key Visual" class="w-full h-full object-cover object-center" loading="eager" />
          </div>
        </div>

        <div class="max-w-3xl mx-auto text-center mt-10 px-6">
          <p class="text-yellow-400 text-sm font-semibold uppercase tracking-widest mb-3">Bank Uncensored Online</p>
          <h1 class="text-2xl md:text-4xl font-bold text-white leading-tight mb-6">
            ก่อนจะถามว่า "กู้ผ่านไหม"<br class="hidden sm:block" />
            คุณควรรู้ก่อนว่า ธุรกิจคุณ<br class="hidden sm:block" />
            คือ <span class="text-yellow-400">"โอกาส"</span> หรือ <span class="text-red-400">"ความเสี่ยง"</span><br class="hidden sm:block" />
            ในสายตาธนาคาร
          </h1>
          <p class="text-gray-300 text-lg leading-relaxed mb-3">
            คลาสออนไลน์ 4 ชั่วโมง สอนโดยอดีต RM ธนาคารกสิกร 7 ปี<br class="hidden md:block" />
            ที่ปัจจุบันเป็นเจ้าของธุรกิจ ใช้สินเชื่อธนาคาร ลงทุนเป็นร้อยล้าน
          </p>
          <p class="text-gray-400 text-base">
            เรียนจบ คุณจะ<span class="text-yellow-400 font-medium">เช็คตัวเองได้ทันที</span> ว่าพร้อมกู้แค่ไหน และต้องแก้อะไรก่อนเดินเข้าธนาคาร
          </p>
        </div>

        <!-- Desktop: grid 3 cols -->
        <div class="max-w-5xl mx-auto mt-10 hidden sm:grid grid-cols-3 gap-4">
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
            <img src="/images/win-ptt-team.webp" alt="วินกับทีมงานที่ปั๊ม PTT" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 border border-yellow-400/20 group-hover:border-yellow-400/50 rounded-2xl transition-colors pointer-events-none"></div>
          </div>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
            <img src="/images/win-cafe-amazon.webp" alt="วินกับธุรกิจ Cafe Amazon" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 border border-yellow-400/20 group-hover:border-yellow-400/50 rounded-2xl transition-colors pointer-events-none"></div>
          </div>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
            <img src="/images/win-7eleven.webp" alt="วินในร้าน 7-Eleven" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 border border-yellow-400/20 group-hover:border-yellow-400/50 rounded-2xl transition-colors pointer-events-none"></div>
          </div>
        </div>

        <!-- Mobile: auto-scroll slider -->
        <div class="sm:hidden mt-8 relative overflow-hidden">
          <div id="hero-slider" class="flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 pb-4 -mx-4" style="scrollbar-width:none;-webkit-overflow-scrolling:touch;">
            <div class="relative shrink-0 w-[80vw] aspect-[4/3] rounded-xl overflow-hidden bg-zinc-900 border border-yellow-400/20">
              <img src="/images/win-ptt-team.webp" alt="วินกับทีมงานที่ปั๊ม PTT" class="absolute inset-0 w-full h-full object-cover snap-center" loading="lazy" />
            </div>
            <div class="relative shrink-0 w-[80vw] aspect-[4/3] rounded-xl overflow-hidden bg-zinc-900 border border-yellow-400/20">
              <img src="/images/win-cafe-amazon.webp" alt="วินกับธุรกิจ Cafe Amazon" class="absolute inset-0 w-full h-full object-cover snap-center" loading="lazy" />
            </div>
            <div class="relative shrink-0 w-[80vw] aspect-[4/3] rounded-xl overflow-hidden bg-zinc-900 border border-yellow-400/20">
              <img src="/images/win-7eleven.webp" alt="วินในร้าน 7-Eleven" class="absolute inset-0 w-full h-full object-cover snap-center" loading="lazy" />
            </div>
          </div>
          <div class="flex justify-center gap-2 mt-3" id="hero-dots">
            <span class="w-2 h-2 rounded-full bg-yellow-400 transition-colors"></span>
            <span class="w-2 h-2 rounded-full bg-zinc-600 transition-colors"></span>
            <span class="w-2 h-2 rounded-full bg-zinc-600 transition-colors"></span>
          </div>
        </div>

        <script>
          const slider = document.getElementById('hero-slider');
          const dots = document.querySelectorAll('#hero-dots span');
          if (slider && dots.length) {
            let current = 0;
            const total = 3;
            let auto: ReturnType<typeof setInterval>;
            setTimeout(() => {
              auto = setInterval(() => {
                current = (current + 1) % total;
                const child = slider.children[current] as HTMLElement;
                slider.scrollTo({ left: child.offsetLeft - 16, behavior: 'smooth' });
              }, 3000);
            }, 2000);
            slider.addEventListener('scroll', () => {
              const scrollLeft = slider.scrollLeft;
              const width = (slider.children[0] as HTMLElement).offsetWidth + 12;
              const index = Math.round(scrollLeft / width);
              dots.forEach((d, i) => {
                d.classList.toggle('bg-yellow-400', i === index);
                d.classList.toggle('bg-zinc-600', i !== index);
              });
              current = index;
            });
            slider.addEventListener('touchstart', () => clearInterval(auto), { passive: true });
          }
        </script>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- S2: MiniStoryHook -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <section class="w-full bg-black py-12 md:py-16 border-t border-zinc-900/60 bg-gradient-to-b from-zinc-900/80 to-transparent p-8 md:p-12 relative overflow-hidden shadow-[0_10px_40px_-15px_rgba(0,0,0,0.5)]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
        <svg class="w-12 h-12 md:w-16 md:h-16 text-yellow-500/20 mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
        </svg>
        <div class="space-y-4 text-gray-300 text-lg md:text-xl leading-relaxed relative z-10 font-medium">
          <p>"ก่อนวินจะออกมาทำธุรกิจของตัวเอง วินเป็น RM ธนาคาร 7 ปี</p>
          <p>เขียนเคสสินเชื่อมาเป็นร้อยเคส รวมวงเงินอนุมัติเป็นพันล้านบาท</p>
          <p>แต่สิ่งที่ทำให้วินตัดสินใจออกมาเปิดคลาสนี้ ไม่ใช่เพราะสิ่งที่เห็นในแบงก์</p>
          <p>แต่เป็นสิ่งที่วินรู้สึก <span class="text-yellow-400">ในวันที่ต้องเซ็นสัญญาค้ำประกันเงินกู้ร้อยล้านด้วยชื่อตัวเอง</span>"</p>
        </div>
        <div class="mt-8 pt-6 border-t border-zinc-800/60 max-w-[200px] mx-auto">
          <p class="text-yellow-500/80 text-sm font-semibold tracking-wide">วิน กวินทร์รัศม์ นิธิกรภาคย์</p>
          <p class="mt-2 text-zinc-500 text-sm italic">(เดี๋ยววินจะเล่าให้ฟัง)</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- S3: OpeningPitch (Pain + Trust Box + Course Intro) -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <section class="w-full bg-[#0a0a0a] py-16 md:py-24 border-t border-yellow-500/10 mt-2">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto mb-12">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">ถ้าคุณกำลังรู้สึกแบบนี้อยู่...</h2>
          <p class="text-gray-400 text-lg leading-relaxed">
            คุณเป็นเจ้าของธุรกิจ ทำงานหนักมาหลายปี ยอดขายก็มี ลูกค้าก็มี กำไรก็พอมี<br class="hidden md:block" />
            แต่พอถึงเวลาต้องใช้เงินขยายกิจการ... คุณก็<span class="text-red-400 font-medium">ไม่กล้าเดินเข้าธนาคาร</span>
          </p>
        </div>

        <div class="max-w-4xl mx-auto flex flex-col space-y-8">
          <!-- Pain bullets -->
          <div class="bg-red-900/10 border border-red-500/20 rounded-2xl p-6 md:p-8">
            <p class="text-white font-semibold mb-5">เพราะ...</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start text-gray-300"><span class="mr-3 text-red-500 shrink-0 mt-0.5 text-lg">⛔️</span><span class="text-base md:text-lg">คุณไม่รู้ว่าธนาคารจะมองธุรกิจเรายังไง</span></li>
              <li class="flex items-start text-gray-300"><span class="mr-3 text-red-500 shrink-0 mt-0.5 text-lg">⛔️</span><span class="text-base md:text-lg">คุณไม่รู้ว่า "ตัวเลขแบบนี้" พอไหม</span></li>
              <li class="flex items-start text-gray-300"><span class="mr-3 text-red-500 shrink-0 mt-0.5 text-lg">⛔️</span><span class="text-base md:text-lg">คุณไม่รู้ว่า "เอกสารชุดนี้" ครบหรือเปล่า</span></li>
              <li class="flex items-start text-gray-300"><span class="mr-3 text-red-500 shrink-0 mt-0.5 text-lg">⛔️</span><span class="text-base md:text-lg">คุณไม่รู้ว่า "ธุรกิจเรา" มีคุณสมบัติพอให้เขาอนุมัติไหม</span></li>
              <li class="flex items-start text-gray-300"><span class="mr-3 text-red-500 shrink-0 mt-0.5 text-lg">⛔️</span><span class="text-base md:text-lg">คุณไม่รู้ว่า "ติดบูโรอยู่แบบนี้" จะยังกู้ได้ไหม หรือต้องแก้ตรงไหนก่อน</span></li>
            </ul>
            <p class="text-white text-lg font-medium italic border-t border-red-500/20 pt-5">
              และสิ่งที่เจ็บที่สุดคือ <span class="text-red-400">คุณไม่รู้ด้วยซ้ำว่าต้องไปถามใคร</span> เพื่อให้ได้คำตอบที่ตรงไปตรงมา
            </p>
          </div>

          <!-- Teaching photos row 1: 3 portrait -->
          <div class="grid grid-cols-3 gap-3 md:gap-4">
            <div class="relative w-full aspect-[3/4] rounded-xl md:rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
              <img src="/images/win-consult-client.webp" alt="วินถือไมค์สอน" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="relative w-full aspect-[3/4] rounded-xl md:rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
              <img src="/images/win-meeting-bank-rm.webp" alt="วินสอนหน้ากระดาน" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="relative w-full aspect-[3/4] rounded-xl md:rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
              <img src="/images/win-sme-dbank-booth.webp" alt="วินสอนเรื่องงบการเงิน" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
          </div>

          <!-- Teaching photos row 2: 2 portrait -->
          <div class="grid grid-cols-2 gap-3 md:gap-4">
            <div class="relative w-full aspect-[3/4] rounded-xl md:rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
              <img src="/images/win-sme-loan-booth-2.webp" alt="วินชี้ slide สินเชื่อ" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="relative w-full aspect-[3/4] rounded-xl md:rounded-2xl overflow-hidden bg-zinc-900 border border-yellow-400/20 group">
              <img src="/images/win-bank-banner.webp" alt="วินยืนดู banner สินเชื่อ" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
          </div>

          <!-- Bank rejection story -->
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 md:p-8">
            <p class="text-white font-semibold mb-4">หรือบางทีคุณอาจจะเคยไปแบงก์แล้ว...</p>
            <div class="text-gray-200 text-lg leading-relaxed space-y-3 mb-6">
              <p>เตรียมเอกสารมาอย่างดี นั่งรอในธนาคาร พนักงานยิ้มรับ ถ่ายรูปสำเนา เก็บแฟ้มเข้าไป</p>
              <p>แล้วก็... <span class="text-white font-bold">เงียบ</span></p>
              <p>รออยู่เป็นอาทิตย์ เป็นเดือน โทรไปถาม ได้คำตอบเดิม <span class="text-gray-300 italic">"กำลังพิจารณาค่ะ"</span></p>
              <p>จนในที่สุด ได้คำตอบกลับมาว่า... <span class="text-red-400 font-bold text-xl">"ขออภัยค่ะ ครั้งนี้ไม่สามารถอนุมัติได้"</span></p>
              <p class="text-white font-medium">ไม่มีคำอธิบาย ไม่มีเหตุผลชัดๆ มีแค่คำว่า "ไม่ผ่าน"</p>
            </div>
            <p class="text-white font-bold text-lg mb-3">และหลังจากวันนั้น...</p>
            <ul class="space-y-2 text-gray-200 text-lg">
              <li>→ คุณเห็นคู่แข่งได้วงเงิน ในขณะที่คุณยังไปไหนไม่ได้</li>
              <li>→ คุณเห็นโอกาสผ่านไป เพราะไม่มีเงินทุนพอ</li>
              <li>→ และที่หนักที่สุด <span class="text-red-400">คุณเริ่มกลัวที่จะเดินเข้าธนาคารอีก</span></li>
            </ul>
          </div>

          <!-- Trust Box 3 กล่อง -->
          <div class="bg-zinc-900 border border-yellow-500/20 rounded-2xl p-6 md:p-10">
            <p class="text-white text-xl md:text-2xl leading-relaxed mb-2 font-medium">ปัญหาไม่ได้อยู่ที่ธุรกิจของคุณ</p>
            <p class="text-gray-200 text-lg md:text-xl leading-relaxed mb-3">
              ปัญหาอยู่ที่ไม่มีใครเคยอธิบายให้คุณฟังตรงๆ ว่า <span class="text-yellow-400 font-bold">ธนาคารตัดสินจากอะไรจริงๆ</span>
            </p>
            <p class="text-gray-300 text-lg mb-8">
              ไม่ใช่แค่จากเอกสาร ไม่ใช่จากยอดขาย ไม่ใช่จากกำไรในงบ แต่เป็น <span class="text-white font-bold">3 กล่อง</span>ที่ซ่อนอยู่เบื้องหลังการอนุมัติทุกเคส
            </p>
            <p class="text-yellow-400 font-black text-2xl md:text-3xl mb-8 text-center">📦 Trust Box 3 กล่อง</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-5">
              <div class="bg-black/60 rounded-2xl p-6 border border-yellow-500/30 text-center shadow-[0_0_20px_-8px_rgba(250,204,21,0.15)]">
                <span class="text-yellow-400 font-black text-4xl md:text-5xl block mb-3">①</span>
                <p class="text-white font-bold text-lg md:text-xl mb-2">ตัวเจ้าของ</p>
                <p class="text-yellow-400 text-base md:text-lg leading-relaxed font-semibold">ธนาคารเชื่อในตัวคุณไหม?</p>
              </div>
              <div class="bg-black/60 rounded-2xl p-6 border border-yellow-500/30 text-center shadow-[0_0_20px_-8px_rgba(250,204,21,0.15)]">
                <span class="text-yellow-400 font-black text-4xl md:text-5xl block mb-3">②</span>
                <p class="text-white font-bold text-lg md:text-xl mb-2">ตัวธุรกิจ</p>
                <p class="text-yellow-400 text-base md:text-lg leading-relaxed font-semibold">ธุรกิจคุณน่าเชื่อถือไหม?</p>
              </div>
              <div class="bg-black/60 rounded-2xl p-6 border border-yellow-500/30 text-center shadow-[0_0_20px_-8px_rgba(250,204,21,0.15)]">
                <span class="text-yellow-400 font-black text-4xl md:text-5xl block mb-3">③</span>
                <p class="text-white font-bold text-lg md:text-xl mb-2">ตัวเลข</p>
                <p class="text-yellow-400 text-base md:text-lg leading-relaxed font-semibold">ตัวเลขกับเรื่องที่เจ้าของเล่า พูดเรื่องเดียวกันไหม?</p>
              </div>
            </div>
            <div class="bg-red-900/20 border border-red-500/30 rounded-xl p-4 mt-6 text-center">
              <p class="text-red-400 text-lg md:text-xl font-bold">ถ้าคุณขาดแค่กล่องเดียว ธนาคารก็อาจปฏิเสธ ไม่ว่าธุรกิจจะดีแค่ไหนก็ตาม</p>
            </div>
          </div>

          <!-- Course Intro -->
          <div class="border-l-4 border-yellow-500 pl-6 py-2">
            <p class="text-xl md:text-2xl font-bold text-yellow-400 leading-snug mb-3">Bank Uncensored Online คลาส 4 ชั่วโมง ที่จะทำให้คุณเช็คตัวเองได้ ก่อนเดินเข้าธนาคาร</p>
            <p class="text-lg text-gray-300 leading-relaxed mb-2">ไม่ใช่คลาสสอน "เคล็ดลับให้กู้ผ่าน" เพราะไม่มีใครรับประกันได้</p>
            <p class="text-base text-gray-400 leading-relaxed">แต่เป็นคลาสที่จะทำให้คุณเข้าใจว่าธนาคารดูอะไร คิดอะไร และคุณอยู่ตรงไหนในสายตาเขา เรียนจบแล้ว คุณจะไม่ถามว่า "กู้ได้ไหม" อีกต่อไป คุณจะรู้ว่า "ต้องทำอะไรต่อ ก่อนวันที่พร้อมจริงๆ"</p>
          </div>

