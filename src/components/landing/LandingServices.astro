---
import { landingData } from "../../data/landing";

const { services } = landingData;
---

<section class="bg-black border-t border-yellow-400/20 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
        {services.heading}
      </h2>
      <p class="text-gray-400 text-lg">{services.subtitle}</p>
    </div>

    <!-- Service cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {services.cards.map((card) => (
        <a
          href={card.url}
          class="group relative bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden transition-all duration-300 hover:border-yellow-400/50 hover:shadow-[0_0_30px_-10px_rgba(250,204,21,0.3)]"
        >
          <!-- KV Image -->
          {card.image && (
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-black">
              <img
                src={card.image}
                alt={card.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <!-- gradient removed -->
            </div>
          )}

          <!-- Card content -->
          <div class="p-5 space-y-3">
            <h3 class="text-white font-bold text-xl group-hover:text-yellow-400 transition-colors">
              {card.title}
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              {card.subtitle}
            </p>

            <!-- Arrow link -->
            <div class="flex items-center gap-2 text-yellow-400 text-sm font-medium pt-2">
              <span>เรียนรู้เพิ่มเติม</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
