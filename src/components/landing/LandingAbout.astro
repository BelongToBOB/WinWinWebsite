---
import { landingData } from "../../data/landing";

const { about } = landingData;
---

<section id="about" class="bg-[#0a0a0a] border-t border-yellow-400/20 py-16 md:py-24 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
        {about.heading}
      </h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto">
        {about.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Left column: Experience timeline + Bio -->
      <div class="space-y-8">
        <!-- Experience timeline -->
        <div class="space-y-6">
          <h3 class="text-yellow-400 font-semibold text-sm uppercase tracking-wider">
            ประสบการณ์การทำงาน
          </h3>
          <div class="space-y-4">
            {about.experience.map((exp) => (
              <div class="relative pl-6 border-l-2 border-yellow-500/30">
                <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-yellow-500/60 border-2 border-yellow-500"></div>
                <p class="text-white font-semibold">{exp.role}</p>
                <p class="text-gray-400 text-sm">{exp.org}</p>
                <p class="text-gray-500 text-xs mt-1">{exp.period}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Bio -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
          <p class="text-gray-300 leading-relaxed">
            {about.bio}
          </p>
        </div>
      </div>

      <!-- Right column: Businesses + Philosophy + Quote -->
      <div class="space-y-8">
        <!-- Businesses -->
        <div class="space-y-4">
          <h3 class="text-yellow-400 font-semibold text-sm uppercase tracking-wider">
            ธุรกิจและบทบาทปัจจุบัน
          </h3>
          <ul class="space-y-3">
            {about.businesses.map((biz) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-yellow-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-300">{biz}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Philosophy -->
        <div class="space-y-4">
          <h3 class="text-yellow-400 font-semibold text-sm uppercase tracking-wider">
            ปรัชญาและแนวคิด
          </h3>
          {about.philosophy.map((para) => (
            <p class="text-gray-400 leading-relaxed">{para}</p>
          ))}
        </div>

        <!-- Quote -->
        <div class="bg-zinc-900/80 border-l-4 border-yellow-500 rounded-r-2xl p-6">
          <blockquote class="text-yellow-400 font-semibold text-lg md:text-xl leading-relaxed italic">
            "{about.quote}"
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
