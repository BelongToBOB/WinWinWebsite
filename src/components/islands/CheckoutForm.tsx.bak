import { useState } from "react";

interface PricingTier {
  label: string;
  price: string;
  originalPrice?: string;
}

interface Props {
  courseId: string;
  courseName: string;
  pricing: PricingTier[];
}

type PaymentMethod = "chillpay" | "easyslip";

const formatPrice = (price: string) =>
  price.endsWith(".-") ? price : `${price}.-`;

export default function CheckoutForm({ courseId, courseName, pricing }: Props) {
  const [selectedTier, setSelectedTier] = useState(0);
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>("chillpay");
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);

  const currentTier = pricing[selectedTier];

  const handleSubmit = async () => {
    setError(null);

    if (!name.trim() || !email.trim() || !phone.trim()) {
      setError("กรุณากรอกข้อมูลให้ครบทุกช่อง");
      return;
    }

    setLoading(true);

    try {
      // TODO: เปลี่ยนเป็น NestJS endpoint จริงเมื่อพร้อม
      // const res = await fetch("https://api.winwinwealth.co/orders", {
      //   method: "POST",
      //   headers: { "Content-Type": "application/json" },
      //   body: JSON.stringify({
      //     courseId,
      //     courseName,
      //     tier: { label: currentTier.label, price: currentTier.price },
      //     paymentMethod,
      //     customer: { name, email, phone },
      //   }),
      // });
      // if (!res.ok) throw new Error("เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง");

      // Mock response สำหรับ test UI
      await new Promise((r) => setTimeout(r, 1500));
      setSuccess(true);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง"
      );
    } finally {
      setLoading(false);
    }
  };

  if (success) {
    return (
      <section className="w-full bg-[#0a0a0a] py-16 md:py-24 border-t border-yellow-500/10">
        <div className="max-w-md mx-auto px-4 text-center">
          <div className="w-20 h-20 mx-auto mb-6 rounded-full bg-green-500/10 border border-green-500/30 flex items-center justify-center">
            <svg
              className="w-10 h-10 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M5 13l4 4L19 7"
              />
            </svg>
          </div>
          <h3 className="text-2xl font-bold text-white mb-3">
            รับคำสั่งซื้อแล้ว
          </h3>
          <p className="text-gray-400 text-lg">
            ทีมงานจะติดต่อกลับผ่าน LINE ภายใน 24 ชั่วโมง
          </p>
          <p className="text-gray-500 text-sm mt-4">
            {courseName} — {currentTier.label} {formatPrice(currentTier.price)}
          </p>
        </div>
      </section>
    );
  }

  return (
    <section
      id="checkout"
      className="w-full bg-[#0a0a0a] py-16 md:py-24 border-t border-yellow-500/10"
    >
      <div className="max-w-lg mx-auto px-4 sm:px-6">
        <div className="text-center mb-10">
          <h2 className="text-2xl md:text-3xl font-bold text-white mb-2">
            สมัครเรียน
          </h2>
          <p className="text-gray-400">{courseName}</p>
        </div>

        <div className="space-y-8">
          {/* 1. Tier selection */}
          {pricing.length > 1 && (
            <div className="space-y-3">
              <label className="text-sm font-semibold text-gray-300 block">
                เลือกแพ็คเกจ
              </label>
              <div className="space-y-2">
                {pricing.map((tier, i) => (
                  <button
                    key={i}
                    onClick={() => setSelectedTier(i)}
                    className={`w-full text-left p-4 rounded-xl border-2 transition-all duration-200 ${
                      selectedTier === i
                        ? "border-yellow-500 bg-yellow-500/10"
                        : "border-zinc-700 bg-zinc-900 hover:border-zinc-600"
                    }`}
                  >
                    <div className="flex items-center justify-between">
                      <div>
                        <p
                          className={`font-semibold ${
                            selectedTier === i
                              ? "text-yellow-400"
                              : "text-white"
                          }`}
                        >
                          {tier.label}
                        </p>
                        {tier.originalPrice && (
                          <p className="text-gray-500 text-sm line-through">
                            {tier.originalPrice}
                          </p>
                        )}
                      </div>
                      <p
                        className={`text-xl font-bold ${
                          selectedTier === i ? "text-yellow-400" : "text-white"
                        }`}
                      >
                        {formatPrice(tier.price)}
                      </p>
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* 2. Payment method */}
          <div className="space-y-3">
            <label className="text-sm font-semibold text-gray-300 block">
              วิธีชำระเงิน
            </label>
            <div className="grid grid-cols-2 gap-3">
              {(["chillpay", "easyslip"] as PaymentMethod[]).map((method) => (
                <button
                  key={method}
                  onClick={() => setPaymentMethod(method)}
                  className={`py-3 px-4 rounded-xl text-sm font-semibold border-2 transition-all duration-200 ${
                    paymentMethod === method
                      ? "bg-yellow-500 text-black border-yellow-500"
                      : "bg-zinc-900 text-gray-300 border-zinc-700 hover:border-zinc-600"
                  }`}
                >
                  {method === "chillpay" ? "Chill Pay" : "Easy Slip"}
                </button>
              ))}
            </div>
          </div>

          {/* 3. Customer info */}
          <div className="space-y-4">
            <label className="text-sm font-semibold text-gray-300 block">
              ข้อมูลผู้สมัคร
            </label>
            <input
              type="text"
              placeholder="ชื่อ-นามสกุล"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700 text-white placeholder-gray-500 focus:border-yellow-500 focus:outline-none transition-colors"
            />
            <input
              type="email"
              placeholder="อีเมล"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700 text-white placeholder-gray-500 focus:border-yellow-500 focus:outline-none transition-colors"
            />
            <input
              type="tel"
              placeholder="เบอร์โทรศัพท์"
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              className="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700 text-white placeholder-gray-500 focus:border-yellow-500 focus:outline-none transition-colors"
            />
          </div>

          {/* Error */}
          {error && (
            <div className="bg-red-900/20 border border-red-500/30 rounded-xl p-4">
              <p className="text-red-400 text-sm">{error}</p>
            </div>
          )}

          {/* 4. Submit */}
          <button
            onClick={handleSubmit}
            disabled={loading}
            className={`w-full py-4 rounded-xl text-base font-bold transition-all duration-200 ${
              loading
                ? "bg-yellow-500/50 text-black/50 cursor-not-allowed"
                : "bg-yellow-500 text-black hover:bg-yellow-400 hover:scale-[1.02]"
            }`}
          >
            {loading ? (
              <span className="flex items-center justify-center gap-2">
                <svg
                  className="animate-spin w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    className="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    strokeWidth="4"
                  />
                  <path
                    className="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  />
                </svg>
                กำลังดำเนินการ...
              </span>
            ) : (
              `ชำระเงิน ${formatPrice(currentTier.price)}`
            )}
          </button>

          <p className="text-center text-gray-600 text-xs">
            หลังชำระเงิน ทีมงานจะยืนยันการสมัครผ่าน LINE ภายใน 24 ชั่วโมง
          </p>
        </div>
      </div>
    </section>
  );
}
