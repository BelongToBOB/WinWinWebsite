---
interface Props {
  href: string;
  variant?: "line" | "yellow" | "white-outline";
  size?: "normal" | "large";
  class?: string;
  target?: string;
}

const {
  href,
  variant = "yellow",
  size = "normal",
  class: className = "",
  target,
} = Astro.props;

const baseClasses = "inline-flex items-center justify-center font-semibold rounded-xl transition-all duration-200 hover:scale-105";

const sizeMap = {
  normal: "px-6 py-3 text-sm",
  large: "px-8 py-4 text-base",
};

const variantMap = {
  line: "bg-[#00B900] hover:bg-[#009b00] text-white",
  yellow: "bg-yellow-500 hover:bg-yellow-400 text-black",
  "white-outline": "border-2 border-white/20 hover:border-white/40 text-white",
};
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class:list={[baseClasses, sizeMap[size], variantMap[variant], className]}
>
  <slot />
</a>
