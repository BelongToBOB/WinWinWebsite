---
interface Props {
  text: string;
  highlight: string;
}

const { text, highlight } = Astro.props;
---

<div class="border-l-4 border-yellow-500 pl-6 py-2">
  <p class="text-lg md:text-xl text-gray-300 italic mb-2">{text}</p>
  <p class="text-xl md:text-2xl font-bold text-yellow-400">{highlight}</p>
</div>
